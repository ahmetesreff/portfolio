// Cloudflare Workers: statik site (dist/) + küçük yönlendirme kodu (worker/index.js).
// Workers Builds: build `npm run build`, deploy `npx wrangler deploy`.
// Alan adları Worker'a doğrudan bağlı (custom domain; DNS kaydını Cloudflare yönetir, sunucuya bağ yok).
// www ve http istekleri koddan https://ahmetesrefkarabulut.com.tr'ye 301'lenir.
// Sesli asistan ucu ana alanda değil: https://nobetci.ahmetesrefkarabulut.com.tr/jarvis-ses/sor (sunucu).
{
  "name": "portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "ahmetesrefkarabulut.com.tr", "custom_domain": true },
    { "pattern": "www.ahmetesrefkarabulut.com.tr", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Yönlendirme kodu sayfa isteklerinde çalışsın; hash'li /assets/* doğrudan (ücretsiz) sunulsun.
    "run_worker_first": ["/*", "!/assets/*"]
  }
}
